datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  merchants Merchant[]
}

model Merchant {
  id              String        @id @default(uuid())
  userId          String
  name            String
  email           String
  defaultCurrency String        @default("INR")
  defaultLanguage String        @default("English")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
}

model Customer {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  phone        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Transaction {
  id                       String             @id
  provider                 String             @default("RAZORPAY_TEST")
  providerPaymentId        String?            @unique
  providerOrderId          String?
  externalTransactionId    String?            @unique
  externalOrderId          String?
  merchantId               String
  customerId               String
  amount                   Int                // Minor currency units (paise)
  currency                 String             @default("INR")
  status                   String             // PENDING, AUTHORIZED, CAPTURED, FAILED, SETTLEMENT_PENDING, SETTLEMENT_PROCESSED, CANCELLED
  paymentMethod            String             // UPI, CARD, NETBANKING, WALLET
  captured                 Boolean            @default(false)
  customerDebited          Boolean            @default(false)
  riskStatus               String             @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  merchantSettlementStatus String             // PENDING, PROCESSED, FAILED, UNSETTLED
  failureReason            String?
  retryCount               Int                @default(0)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  merchant                 Merchant           @relation(fields: [merchantId], references: [id])
  customer                 Customer           @relation(fields: [customerId], references: [id])
  revenueRiskEvents        RevenueRiskEvent[]
  recoveryCases            RecoveryCase[]
  aiAnalysisLogs           AIAnalysisLog[]
  auditLogs                AuditLog[]

  @@index([providerPaymentId])
  @@index([providerOrderId])
  @@index([status])
  @@index([riskStatus])
  @@index([createdAt])
}

model RevenueRiskEvent {
  id            String    @id @default(uuid())
  transactionId String
  merchantId    String
  riskType      String    // PAYMENT_FAILED, SETTLEMENT_PENDING, CUSTOMER_DEBITED_NOT_SETTLED, CHECKOUT_ABANDONED, SUBSCRIPTION_FAILED, OVERDUE_PAYMENT
  riskLevel     String    // High, Medium, Low, Critical
  amountAtRisk  Int
  reason        String
  status        String    // OPEN, MONITORING, RESOLVED, ESCALATED, STOPPED
  detectedAt    DateTime  @default(now())
  resolvedAt    DateTime?

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  recoveryCases RecoveryCase[]
}

model RecoveryCase {
  id                String           @id @default(uuid())
  riskEventId       String
  transactionId     String
  status            String           @default("OPEN") // OPEN, ANALYZING, ACTION_RECOMMENDED, AWAITING_APPROVAL, APPROVED, EXECUTING, VERIFYING, VERIFIED_RECOVERED, FAILED, ESCALATED, STOPPED
  priority          String           @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT, Critical
  recommendedAction String?          // RETRY_PAYMENT, REQUEST_CUSTOMER_RETRY, VERIFY_PAYMENT, VERIFY_SETTLEMENT, ESCALATE, STOP_RECOVERY
  currentAction     String?
  approvalRequired  Boolean          @default(false)
  approvedBy        String?
  approvedAt        DateTime?
  rejectionReason   String?
  attempts          Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  transaction       Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  riskEvent         RevenueRiskEvent @relation(fields: [riskEventId], references: [id], onDelete: Cascade)
  aiDecisions       AIDecision[]
  recoveryActions   RecoveryAction[]
  aiAnalysisLogs    AIAnalysisLog[]
  auditLogs         AuditLog[]
}

model AIDecision {
  id                String       @id @default(uuid())
  recoveryCaseId    String
  rootCause         String       @default("UNKNOWN")
  riskLevel         String       // LOW, MEDIUM, HIGH, CRITICAL
  recommendedAction String       // RETRY_PAYMENT, REQUEST_CUSTOMER_RETRY, VERIFY_PAYMENT, VERIFY_SETTLEMENT, ESCALATE, STOP_RECOVERY
  confidence        Float
  reasoningSummary  String       @default("")
  priority          String       @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  shouldEscalate    Boolean      @default(false)
  stopRecovery      Boolean      @default(false)
  merchantMessage   String?
  decisionSource    String       @default("RULE_ENGINE") // OPENAI or RULE_ENGINE
  model             String       @default("gpt-4o")
  createdAt         DateTime     @default(now())

  recoveryCase      RecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)
}

model RecoveryAction {
  id                 String       @id @default(uuid())
  recoveryCaseId     String
  paymentId          String?
  actionType         String       // RETRY_PAYMENT, REQUEST_CUSTOMER_RETRY, VERIFY_PAYMENT, VERIFY_SETTLEMENT, ESCALATE, STOP_RECOVERY
  status             String       @default("PENDING") // PENDING, EXECUTING, COMPLETED, FAILED, CANCELLED, SUCCESS, BLOCKED
  attemptNumber      Int          @default(1)
  amount             Int?
  currency           String       @default("INR")
  providerReference  String?
  idempotencyKey     String?      @unique
  guardrailResult    String?      // PASSED, BLOCKED, HUMAN_APPROVAL_REQUIRED
  result             String?
  initiatedAt        DateTime     @default(now())
  completedAt        DateTime?
  failureReason      String?
  verificationStatus String?      // PENDING, VERIFIED, FAILED
  executedAt         DateTime     @default(now())
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now()) @updatedAt

  recoveryCase       RecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(uuid())
  merchantId  String
  type        String   // RISK_DETECTED, RECOVERY_STARTED, RECOVERY_COMPLETED, RECOVERY_BLOCKED, HUMAN_APPROVAL_REQUIRED, RECOVERY_ESCALATED
  title       String
  message     String
  severity    String   // info, success, warning, error
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model AuditLog {
  id             String       @id @default(uuid())
  merchantId     String
  transactionId  String?
  recoveryCaseId String?
  eventType      String       // RECOVERY_CASE_CREATED, AI_ANALYSIS_STARTED, AI_ANALYSIS_COMPLETED, RECOVERY_ACTION_RECOMMENDED, GUARDRAIL_CHECKED, APPROVAL_REQUIRED, RECOVERY_APPROVED, RECOVERY_REJECTED, RECOVERY_EXECUTION_STARTED, RECOVERY_EXECUTION_COMPLETED, RECOVERY_EXECUTION_FAILED, VERIFICATION_STARTED, VERIFICATION_COMPLETED, RECOVERY_VERIFIED, RECOVERY_ESCALATED, RECOVERY_STOPPED
  actor          String       // SYSTEM, MERCHANT, AI, HUMAN
  description    String
  metadata       String?      // JSON payload details
  createdAt      DateTime     @default(now())

  transaction    Transaction? @relation(fields: [transactionId], references: [id])
  recoveryCase   RecoveryCase? @relation(fields: [recoveryCaseId], references: [id])
}

model AIAnalysisLog {
  id             String       @id @default(uuid())
  transactionId  String
  recoveryCaseId String
  model          String
  status         String       @default("SUCCESS") // SUCCESS, FALLBACK, FAILED
  latencyMs      Int          @default(0)
  inputSummary   String       @default("")
  decision       String
  confidence     Float
  errorMessage   String?
  createdAt      DateTime     @default(now())

  transaction    Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  recoveryCase   RecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id              String   @id @default(uuid())
  externalEventId String   @unique
  eventType       String
  payload         String
  signature       String
  processed       Boolean  @default(false)
  createdAt       DateTime @default(now())
}
